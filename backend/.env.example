# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Used only as fallback when the UI does not send model_id
OPENAI_MODEL=gpt-4.1-mini

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Default when no UI model is sent: openai | groq | nvidia | heuristic
# UI model picker overrides this for each run.
LLM_PROVIDER=openai

HOST=127.0.0.1
PORT=8001

# Demo logger: when 1/true, log full post-mask page_markdown received by /agent/run
DEBUG=0

# UI model choices map to:
#   openai-gpt      -> gpt-4.1-mini (OpenAI API)
#   groq-qwen       -> qwen/qwen3.6-27b
#   nvidia-llama    -> meta/llama-3.2-11b-vision-instruct
#   nvidia-nemotron -> nvidia/nemotron-3-super-120b-a12b
